# fido-admin.sh 설정 예시.
#
# 공통 값은 fido-admin.env, 프로파일별 값은 fido-admin-<프로파일>.env 로 복사해 채운다.
#   예) fido-admin-qa.env, fido-admin-prod.env
# 같은 키는 환경 변수 > 프로파일 전용 파일 > 공통 파일 순으로 앞의 것이 이긴다.
# 이 파일들은 비밀값이 들어가므로 저장소에 올리지 않는다(.gitignore).

# 기본 프로파일. start/restart 에 프로파일 인자를 주면 그쪽이 우선한다(공통 파일에만 의미가 있다).
#SPRING_PROFILES_ACTIVE=prod

# DB 접속 정보(local 외 프로파일은 필수). 평문 대신 ENC(...) 암호문을 쓸 수 있다 — README "DB 접속 정보 암호화" 참고.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@db-host:1521/SERVICE
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# 암호문을 쓸 때만
#DB_CONFIG_KEY=

# 인증 없는 서버 간 경로의 접근 허용 대역(쉼표 구분). 비우면 모두 허용
#FIDO_ADMIN_EXTERNAL_ALLOWED_CIDRS=10.0.0.0/8

# 선택 항목
#APP_JAR=/opt/fido-admin/fido-admin.jar
#LOG_PATH=/var/log/fido-admin
#JAVA_HOME=/usr/lib/jvm/java-17
#JAVA_OPTS=-Xms512m -Xmx1g
#STOP_TIMEOUT=60
